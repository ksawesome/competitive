% makeindex style for the handbook: letter headings, dotted leaders to page numbers
headings_flag 1
heading_prefix "\\par\\medskip{\\sffamily\\bfseries\\color{cpblue}"
heading_suffix "}\\par\\nopagebreak\\smallskip\n"
symhead_positive "Symbols"
numhead_positive "Numbers"
delim_0 "\\dotfill "
delim_1 "\\dotfill "
delim_2 "\\dotfill "
