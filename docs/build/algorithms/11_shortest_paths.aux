\@writefile{toc}{\contentsline {section}{\numberline {12.5}Negative weights: Bellman--Ford}{157}{section.12.5}\protected@file@percent }
\newlabel{sec:bellman}{{12.5}{157}{Negative weights: Bellman--Ford}{section.12.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.4}{\ignorespaces A negative cycle (red) and a vertex that depends on it. Everything reachable from a negative cycle has distance $-\infty $.}}{158}{figure.caption.207}\protected@file@percent }
\newlabel{fig:negcycle}{{12.4}{158}{A negative cycle (red) and a vertex that depends on it. Everything reachable from a negative cycle has distance $-\infty $}{figure.caption.207}{}}
\newlabel{tpl:cpbellman}{{12.5}{158}{Negative weights: Bellman--Ford}{section*.208}{}}
