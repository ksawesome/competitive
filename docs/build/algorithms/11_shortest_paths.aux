\@writefile{toc}{\contentsline {section}{\numberline {12.1}Choosing the algorithm}{151}{section.12.1}\protected@file@percent }
\newlabel{sec:sp-choose}{{12.1}{151}{Choosing the algorithm}{section.12.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces Which shortest-path algorithm? A DAG allows any weights (and even longest paths) with a simple DP; negative weights in a graph with cycles need Bellman--Ford, or Floyd--Warshall for all pairs.}}{151}{figure.caption.201}\protected@file@percent }
\newlabel{fig:spflow}{{12.1}{151}{Which shortest-path algorithm? A DAG allows any weights (and even longest paths) with a simple DP; negative weights in a graph with cycles need Bellman--Ford, or Floyd--Warshall for all pairs}{figure.caption.201}{}}
