\@writefile{toc}{\contentsline {section}{\numberline {12.3}Dijkstra's algorithm}{152}{section.12.3}\protected@file@percent }
\newlabel{sec:dijkstra}{{12.3}{152}{Dijkstra's algorithm}{section.12.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.2}{\ignorespaces Dijkstra's algorithm from S. Green vertices are final, red is the vertex being finalised, blue ones are in the queue with a tentative distance, and thick blue edges are the current parent pointers. The last step finalises T with distance 10, and the parent pointers form the shortest-path tree.}}{153}{figure.caption.203}\protected@file@percent }
\newlabel{fig:dijkstra}{{12.2}{153}{Dijkstra's algorithm from S. Green vertices are final, red is the vertex being finalised, blue ones are in the queue with a tentative distance, and thick blue edges are the current parent pointers. The last step finalises T with distance 10, and the parent pointers form the shortest-path tree}{figure.caption.203}{}}
\newlabel{tpl:cpdijkstra}{{12.3}{153}{Dijkstra's algorithm}{section*.204}{}}
