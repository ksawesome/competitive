\@writefile{toc}{\contentsline {section}{\numberline {12.6}Difference constraints}{159}{section.12.6}\protected@file@percent }
\newlabel{sec:diffcons}{{12.6}{159}{Difference constraints}{section.12.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.5}{\ignorespaces A system of difference constraints as a graph. Each constraint $x_b - x_a \le c$ is an edge $a \to b$ of weight $c$; shortest distances from a virtual source satisfy all constraints at once.}}{160}{figure.caption.209}\protected@file@percent }
\newlabel{fig:diffcons}{{12.5}{160}{A system of difference constraints as a graph. Each constraint $x_b - x_a \le c$ is an edge $a \to b$ of weight $c$; shortest distances from a virtual source satisfy all constraints at once}{figure.caption.209}{}}
\newlabel{tpl:cpdiffcons}{{12.6}{160}{Difference constraints}{section*.210}{}}
\@writefile{toc}{\contentsline {section}{\numberline {12.7}All pairs: Floyd--Warshall}{161}{section.12.7}\protected@file@percent }
\newlabel{sec:floyd}{{12.7}{161}{All pairs: Floyd--Warshall}{section.12.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.6}{\ignorespaces The Floyd--Warshall recurrence. With stops up to $k$ allowed, the best path from $i$ to $j$ either avoids $k$ (grey) or visits it once, and then both halves use only stops below $k$ (blue).}}{161}{figure.caption.211}\protected@file@percent }
\newlabel{fig:floyd}{{12.6}{161}{The Floyd--Warshall recurrence. With stops up to $k$ allowed, the best path from $i$ to $j$ either avoids $k$ (grey) or visits it once, and then both halves use only stops below $k$ (blue)}{figure.caption.211}{}}
\newlabel{tpl:cpfloyd}{{12.7}{161}{All pairs: Floyd--Warshall}{section*.212}{}}
