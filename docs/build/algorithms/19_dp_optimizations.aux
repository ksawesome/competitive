\@writefile{lof}{\contentsline {figure}{\numberline {20.4}{\ignorespaces Monster Game~I on the sample with $x = 100$: one line per earlier kill, $y = f_j t + dp_j$. Each query takes the lowest line at $t = s_i$ (blue points, using only the lines that existed at that time). Of the six lines, only $100t$ and $20t + 3000$ end up on the final lower envelope (orange).}}{287}{figure.caption.376}\protected@file@percent }
\newlabel{fig:cht}{{20.4}{287}{Monster Game~I on the sample with $x = 100$: one line per earlier kill, $y = f_j t + dp_j$. Each query takes the lowest line at $t = s_i$ (blue points, using only the lines that existed at that time). Of the six lines, only $100t$ and $20t + 3000$ end up on the final lower envelope (orange)}{figure.caption.376}{}}
