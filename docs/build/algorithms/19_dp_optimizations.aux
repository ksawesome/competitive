\@writefile{lof}{\contentsline {figure}{\numberline {20.7}{\ignorespaces Merging the slopes of two convex sequences gives their $(\min , +)$ convolution. Here the result is $c = (0, -3, -5, -6, -6, -5, -3)$, exactly what the brute force $\min _{i + j = k}(a_i + b_j)$ computes.}}{292}{figure.caption.385}\protected@file@percent }
\newlabel{fig:minplus}{{20.7}{292}{Merging the slopes of two convex sequences gives their $(\min , +)$ convolution. Here the result is $c = (0, -3, -5, -6, -6, -5, -3)$, exactly what the brute force $\min _{i + j = k}(a_i + b_j)$ computes}{figure.caption.385}{}}
