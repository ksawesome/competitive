\@writefile{lof}{\contentsline {figure}{\numberline {20.5}{\ignorespaces Slope trick on $a = 3, 1, 2$ (make it non-decreasing at the least total change). Each panel is the cost as a function of the value $v$ of the last element; red dots mark the breakpoints that matter. The answer is the minimum of $f_3$, which is 2 (for example $1, 1, 2$).}}{289}{figure.caption.382}\protected@file@percent }
\newlabel{fig:slopetrick}{{20.5}{289}{Slope trick on $a = 3, 1, 2$ (make it non-decreasing at the least total change). Each panel is the cost as a function of the value $v$ of the last element; red dots mark the breakpoints that matter. The answer is the minimum of $f_3$, which is 2 (for example $1, 1, 2$)}{figure.caption.382}{}}
\newlabel{tpl:cpslope}{{20.6}{289}{Slope trick}{section*.383}{}}
\@writefile{toc}{\contentsline {section}{\numberline {20.7}Aliens trick}{290}{section.20.7}\protected@file@percent }
\newlabel{sec:aliens}{{20.7}{290}{Aliens trick}{section.20.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20.6}{\ignorespaces The best total $g(k)$ of exactly $k$ disjoint subarrays of $5, -2, 4, -6, 3, -1, 2, -3, 4$ is concave. With a penalty of 2 per subarray the penalised optimum is $g(k) - 2k = 9$, attained at $k = 3$ \emph  {and} $k = 4$ (red): a tie, because the slope from 3 to 4 is exactly 2.}}{290}{figure.caption.384}\protected@file@percent }
\newlabel{fig:aliens}{{20.6}{290}{The best total $g(k)$ of exactly $k$ disjoint subarrays of $5, -2, 4, -6, 3, -1, 2, -3, 4$ is concave. With a penalty of 2 per subarray the penalised optimum is $g(k) - 2k = 9$, attained at $k = 3$ \emph {and} $k = 4$ (red): a tie, because the slope from 3 to 4 is exactly 2}{figure.caption.384}{}}
