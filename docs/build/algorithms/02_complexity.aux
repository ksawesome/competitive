\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces How fast common complexities grow (both axes logarithmic). Each curve crosses the one-second budget (dashed) at the largest $n$ it can handle: $n!$ near 11, $2^n$ near 27, $n^3$ near 460, $n^2$ near $10^4$, $n\log n$ near $4.5\cdot 10^6$. Polynomials are straight lines in this view; exponentials bend upwards and escape almost immediately.}}{30}{figure.caption.43}\protected@file@percent }
\newlabel{fig:growth}{{3.1}{30}{How fast common complexities grow (both axes logarithmic). Each curve crosses the one-second budget (dashed) at the largest $n$ it can handle: $n!$ near 11, $2^n$ near 27, $n^3$ near 460, $n^2$ near $10^4$, $n\log n$ near $4.5\cdot 10^6$. Polynomials are straight lines in this view; exponentials bend upwards and escape almost immediately}{figure.caption.43}{}}
