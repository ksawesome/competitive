\newlabel{sec:recursion}{{3.6}{34}{Recursion}{section.3.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces The recursion tree of merge sort, $T(n) = 2T(n/2) + \Theta (n)$. Every level does $\Theta (n)$ work in total and there are $\log _2 n$ levels, so $T(n) = \Theta (n \log n)$.}}{34}{figure.caption.59}\protected@file@percent }
\newlabel{fig:mergesort-tree}{{3.4}{34}{The recursion tree of merge sort, $T(n) = 2T(n/2) + \Theta (n)$. Every level does $\Theta (n)$ work in total and there are $\log _2 n$ levels, so $T(n) = \Theta (n \log n)$}{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Work per level of the recursion tree in the three cases of the master theorem. Geometric decrease means the top level dominates; a constant means $\log n$ equal levels; geometric increase means the leaves dominate.}}{35}{figure.caption.60}\protected@file@percent }
\newlabel{fig:master}{{3.5}{35}{Work per level of the recursion tree in the three cases of the master theorem. Geometric decrease means the top level dominates; a constant means $\log n$ equal levels; geometric increase means the leaves dominate}{figure.caption.60}{}}
