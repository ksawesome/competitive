\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces The cost of 32 \texttt  {push\_back} calls with capacity doubling. A few pushes are expensive (red: they copy the whole vector), but the average cost per push (green) never exceeds 3.}}{33}{figure.caption.58}\protected@file@percent }
\newlabel{fig:doubling}{{3.3}{33}{The cost of 32 \texttt {push\_back} calls with capacity doubling. A few pushes are expensive (red: they copy the whole vector), but the average cost per push (green) never exceeds 3}{figure.caption.58}{}}
