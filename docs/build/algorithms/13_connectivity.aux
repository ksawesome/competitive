\@writefile{lof}{\contentsline {figure}{\numberline {14.1}{\ignorespaces A directed graph with three strongly connected components (shaded), and its condensation.}}{177}{figure.caption.230}\protected@file@percent }
\newlabel{fig:scc}{{14.1}{177}{A directed graph with three strongly connected components (shaded), and its condensation}{figure.caption.230}{}}
\@writefile{toc}{\contentsline {paragraph}{Tarjan's algorithm.}{177}{paragraph*.231}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14.2}{\ignorespaces Tarjan's algorithm on a graph with three SCCs; labels are $\mathit  {tin}/\mathit  {low}$, blue edges are tree edges and red dashed edges go back to open vertices. Vertex $g$ finishes first with $\mathit  {low} = \mathit  {tin}$ and forms SCC 1; then vertex $d$ (popping $f$, $e$, $d$), then vertex $a$. Components come out in reverse topological order of the condensation.}}{178}{figure.caption.232}\protected@file@percent }
\newlabel{fig:tarjan}{{14.2}{178}{Tarjan's algorithm on a graph with three SCCs; labels are $\mathit {tin}/\mathit {low}$, blue edges are tree edges and red dashed edges go back to open vertices. Vertex $g$ finishes first with $\mathit {low} = \mathit {tin}$ and forms SCC 1; then vertex $d$ (popping $f$, $e$, $d$), then vertex $a$. Components come out in reverse topological order of the condensation}{figure.caption.232}{}}
\newlabel{tpl:cpscc}{{14.1}{179}{Tarjan's algorithm}{section*.233}{}}
\@writefile{toc}{\contentsline {paragraph}{Why components come out in reverse topological order.}{179}{paragraph*.234}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {14.2}2-SAT}{181}{section.14.2}\protected@file@percent }
