\@writefile{lof}{\contentsline {figure}{\numberline {14.3}{\ignorespaces An implication graph with two SCCs that are mirror images of each other. The edge between them fixes the order, and the later component is set true: $a = \text  {true}$, $b = \text  {false}$, $c = \text  {true}$.}}{182}{figure.caption.235}\protected@file@percent }
\newlabel{fig:2sat}{{14.3}{182}{An implication graph with two SCCs that are mirror images of each other. The edge between them fixes the order, and the later component is set true: $a = \text {true}$, $b = \text {false}$, $c = \text {true}$}{figure.caption.235}{}}
\newlabel{tpl:cp2sat}{{14.2}{183}{2-SAT}{section*.236}{}}
