\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces A queue with minimum built from two stacks. Each entry stores its value and, in grey, the minimum of its stack from the bottom up to it. Pouring reverses the order, so the oldest element is popped first.}}{58}{figure.caption.86}\protected@file@percent }
\newlabel{fig:twostacks}{{5.7}{58}{A queue with minimum built from two stacks. Each entry stores its value and, in grey, the minimum of its stack from the bottom up to it. Pouring reverses the order, so the oldest element is popped first}{figure.caption.86}{}}
