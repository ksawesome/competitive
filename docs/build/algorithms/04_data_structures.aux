\newlabel{ch:ds-basics}{{5}{50}{Choosing a Data Structure}{chapter.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.1}Operations decide}{50}{section.5.1}\protected@file@percent }
\newlabel{sec:ops-decide}{{5.1}{50}{Operations decide}{section.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces The cost of each operation, in $\mathcal  {O}$-notation, for five ways to store a dynamic set (green: constant, orange: logarithmic or $n \log n$, red: linear). No structure is best at everything; the balanced tree is the only one with no red cell among the everyday operations, which is why \texttt  {set} is the default for ``sorted and changing''.}}{50}{figure.caption.75}\protected@file@percent }
\newlabel{fig:ds-costs}{{5.1}{50}{The cost of each operation, in $\mathcal {O}$-notation, for five ways to store a dynamic set (green: constant, orange: logarithmic or $n \log n$, red: linear). No structure is best at everything; the balanced tree is the only one with no red cell among the everyday operations, which is why \texttt {set} is the default for ``sorted and changing''}{figure.caption.75}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Stacks}{51}{section.5.2}\protected@file@percent }
\newlabel{sec:stacks}{{5.2}{51}{Stacks}{section.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Matching \texttt  {([]\{()\})} with a stack. Each column shows the stack after reading the character above it; a closing bracket always meets its partner on top, and the stack ends empty.}}{51}{figure.caption.76}\protected@file@percent }
\newlabel{fig:brackets}{{5.2}{51}{Matching \texttt {([]\{()\})} with a stack. Each column shows the stack after reading the character above it; a closing bracket always meets its partner on top, and the stack ends empty}{figure.caption.76}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2.1}The monotonic stack}{51}{subsection.5.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Nearest smaller values of $2, 5, 1, 4, 8, 3, 2, 5$ (positions under the bars). Each arrow points to the answer. The stack, bottom to top, only ever holds increasing values: when 3 arrives, 8 and 4 are popped for good, because 3 hides them from everything to its right.}}{52}{figure.caption.77}\protected@file@percent }
\newlabel{fig:monostack}{{5.3}{52}{Nearest smaller values of $2, 5, 1, 4, 8, 3, 2, 5$ (positions under the bars). Each arrow points to the answer. The stack, bottom to top, only ever holds increasing values: when 3 arrives, 8 and 4 are popped for good, because 3 hides them from everything to its right}{figure.caption.77}{}}
\newlabel{tpl:cpmonostack}{{5.2.1}{52}{The monotonic stack}{section*.78}{}}
