\@writefile{toc}{\contentsline {section}{\numberline {5.4}Heaps}{54}{section.5.4}\protected@file@percent }
\newlabel{sec:heaps}{{5.4}{54}{Heaps}{section.5.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4.1}How a heap works}{54}{subsection.5.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Inserting 10 into a max-heap. The new element rises along one path from the bottom to the root; everything off that path is untouched, so the cost is the height of the tree, $\ensuremath  {\mathcal  {O}(\log n)}$.}}{54}{figure.caption.81}\protected@file@percent }
\newlabel{fig:siftup}{{5.4}{54}{Inserting 10 into a max-heap. The new element rises along one path from the bottom to the root; everything off that path is untouched, so the cost is the height of the tree, $\Oh {\log n}$}{figure.caption.81}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4.2}Scheduling with a heap}{55}{subsection.5.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4.3}The running median with two heaps}{55}{subsection.5.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Two heaps split the numbers at the median. Only the two tops are ever inspected, and they sit on either side of the split, so the median is always at hand.}}{56}{figure.caption.82}\protected@file@percent }
\newlabel{fig:twoheaps}{{5.5}{56}{Two heaps split the numbers at the median. Only the two tops are ever inspected, and they sit on either side of the split, so the median is always at hand}{figure.caption.82}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.5}Ordered sets and interval sets}{56}{section.5.5}\protected@file@percent }
\newlabel{sec:ordered-sets}{{5.5}{56}{Ordered sets and interval sets}{section.5.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.1}Sets of intervals}{57}{subsection.5.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Inserting $[6, 10]$ into a set of disjoint intervals. It overlaps $[5, 7]$ and $[9, 12]$ (red), which are erased and replaced, together with it, by their union $[5, 12]$. The overlapping intervals are consecutive in the \texttt  {map}, so one \texttt  {lower\_bound} and a short walk find them all.}}{57}{figure.caption.83}\protected@file@percent }
\newlabel{fig:intervalset}{{5.6}{57}{Inserting $[6, 10]$ into a set of disjoint intervals. It overlaps $[5, 7]$ and $[9, 12]$ (red), which are erased and replaced, together with it, by their union $[5, 12]$. The overlapping intervals are consecutive in the \texttt {map}, so one \texttt {lower\_bound} and a short walk find them all}{figure.caption.83}{}}
