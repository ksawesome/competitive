\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces The monotonic deque on $1, 3, -1, -3, 5, 3, 6, 7$ with $k = 3$. Values are shown instead of indices.}}{53}{table.caption.79}\protected@file@percent }
\newlabel{tab:deque-trace}{{5.1}{53}{The monotonic deque on $1, 3, -1, -3, 5, 3, 6, 7$ with $k = 3$. Values are shown instead of indices}{table.caption.79}{}}
