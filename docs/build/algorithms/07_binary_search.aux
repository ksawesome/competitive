\@writefile{toc}{\contentsline {section}{\numberline {8.2}Binary search on a monotone predicate}{96}{section.8.2}\protected@file@percent }
\newlabel{sec:predicate}{{8.2}{96}{Binary search on a monotone predicate}{section.8.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Monotone predicates. Top: false up to some point, true afterwards; binary search finds the first true value. Bottom: the ``maximise'' form, true up to some point; its last true value is one less than its first false value.}}{96}{figure.caption.127}\protected@file@percent }
\newlabel{fig:monotone}{{8.3}{96}{Monotone predicates. Top: false up to some point, true afterwards; binary search finds the first true value. Bottom: the ``maximise'' form, true up to some point; its last true value is one less than its first false value}{figure.caption.127}{}}
\newlabel{tpl:cpbsearch}{{8.2}{97}{Binary search on a monotone predicate}{section*.128}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2.1}Beyond monotonicity: keep a half that surely contains an answer}{97}{subsection.8.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces Finding a local minimum by binary search. Each step compares $a_{mid}$ with $a_{mid+1}$ and keeps the half on the downhill side; that half is guaranteed to contain a local minimum, although not necessarily the global one.}}{98}{figure.caption.129}\protected@file@percent }
\newlabel{fig:localmin}{{8.4}{98}{Finding a local minimum by binary search. Each step compares $a_{mid}$ with $a_{mid+1}$ and keeps the half on the downhill side; that half is guaranteed to contain a local minimum, although not necessarily the global one}{figure.caption.129}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.3}Binary search on the answer}{98}{section.8.3}\protected@file@percent }
\newlabel{sec:bsearch-answer}{{8.3}{98}{Binary search on the answer}{section.8.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.5}{\ignorespaces The greedy check for stalls $1, 2, 4, 8, 9$ and $k = 3$ cows. With $d = 3$ the cows go to 1, 4 and 8; with $d = 4$ only two fit (1 and 8). The answer is 3, the largest $d$ that passes.}}{99}{figure.caption.130}\protected@file@percent }
\newlabel{fig:cows}{{8.5}{99}{The greedy check for stalls $1, 2, 4, 8, 9$ and $k = 3$ cows. With $d = 3$ the cows go to 1, 4 and 8; with $d = 4$ only two fit (1 and 8). The answer is 3, the largest $d$ that passes}{figure.caption.130}{}}
