\newlabel{tpl:cpbsreal}{{8.4}{100}{Real numbers and fractional programming}{section*.132}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4.1}Maximising a ratio}{101}{subsection.8.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Dinkelbach's method.}{101}{paragraph*.133}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.7}{\ignorespaces Fractional programming with three choices. The best ratio $\lambda ^\ast = 4$ is the root of the upper envelope $g$ (thick blue). Dinkelbach's method starts at $\lambda _0 = 0$, where the best line is $10 - 4\lambda $; its root gives $\lambda _1 = 10/4$. At $\lambda _1$ the best line is $4 - \lambda $, whose root $\lambda _2 = 4$ is the answer.}}{102}{figure.caption.134}\protected@file@percent }
\newlabel{fig:dinkelbach}{{8.7}{102}{Fractional programming with three choices. The best ratio $\lambda ^\ast = 4$ is the root of the upper envelope $g$ (thick blue). Dinkelbach's method starts at $\lambda _0 = 0$, where the best line is $10 - 4\lambda $; its root gives $\lambda _1 = 10/4$. At $\lambda _1$ the best line is $4 - \lambda $, whose root $\lambda _2 = 4$ is the answer}{figure.caption.134}{}}
