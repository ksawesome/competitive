\@writefile{lof}{\contentsline {figure}{\numberline {8.6}{\ignorespaces The $5 \times 5$ multiplication table. The entries $\le 8$ (blue) form a staircase; row $i$ contributes $\min (n, \lfloor 8/i \rfloor )$ of them (right).}}{100}{figure.caption.131}\protected@file@percent }
\newlabel{fig:multtable}{{8.6}{100}{The $5 \times 5$ multiplication table. The entries $\le 8$ (blue) form a staircase; row $i$ contributes $\min (n, \lfloor 8/i \rfloor )$ of them (right)}{figure.caption.131}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.4}Real numbers and fractional programming}{100}{section.8.4}\protected@file@percent }
