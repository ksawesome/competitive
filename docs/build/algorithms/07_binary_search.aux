\@writefile{lof}{\contentsline {figure}{\numberline {8.8}{\ignorespaces One step of ternary search for a maximum. Since $f(m_1) < f(m_2)$, the maximum cannot lie in $[0, m_1]$ (grey), which is discarded.}}{102}{figure.caption.135}\protected@file@percent }
\newlabel{fig:ternary}{{8.8}{102}{One step of ternary search for a maximum. Since $f(m_1) < f(m_2)$, the maximum cannot lie in $[0, m_1]$ (grey), which is discarded}{figure.caption.135}{}}
