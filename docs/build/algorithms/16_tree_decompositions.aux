\@writefile{toc}{\contentsline {section}{\numberline {17.1}Heavy-light decomposition}{230}{section.17.1}\protected@file@percent }
\newlabel{sec:hld}{{17.1}{230}{Heavy-light decomposition}{section.17.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Heavy and light edges.}{230}{paragraph*.299}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.1}{\ignorespaces Heavy-light decomposition of the running example. Heavy edges form the chains 0--1--4--7--11 and 2--6--10--12; every other vertex is a chain by itself. Numbering each chain from its head, and only then the light subtrees hanging from it, deepest first, makes every chain \emph  {and} every subtree a contiguous block of positions.}}{231}{figure.caption.300}\protected@file@percent }
\newlabel{fig:hld}{{17.1}{231}{Heavy-light decomposition of the running example. Heavy edges form the chains 0--1--4--7--11 and 2--6--10--12; every other vertex is a chain by itself. Numbering each chain from its head, and only then the light subtrees hanging from it, deepest first, makes every chain \emph {and} every subtree a contiguous block of positions}{figure.caption.300}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.2}{\ignorespaces The light-edge lemma behind every $\log n$ bound of this section.}}{231}{figure.caption.301}\protected@file@percent }
\newlabel{fig:hldlight}{{17.2}{231}{The light-edge lemma behind every $\log n$ bound of this section}{figure.caption.301}{}}
\@writefile{toc}{\contentsline {paragraph}{Positions.}{231}{paragraph*.302}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Answering a path query.}{231}{paragraph*.303}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.3}{\ignorespaces A path query on the running example. The path from 11 to 9 (green) is cut into three chain pieces, which are three ranges of positions (framed); each costs one segment-tree query.}}{232}{figure.caption.304}\protected@file@percent }
\newlabel{fig:hldpath}{{17.3}{232}{A path query on the running example. The path from 11 to 9 (green) is cut into three chain pieces, which are three ranges of positions (framed); each costs one segment-tree query}{figure.caption.304}{}}
\newlabel{tpl:cphld}{{17.1}{233}{Answering a path query}{section*.305}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.2}Centroid decomposition}{233}{section.17.2}\protected@file@percent }
\newlabel{sec:centroid}{{17.2}{233}{Centroid decomposition}{section.17.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Centroids.}{234}{paragraph*.306}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The decomposition.}{234}{paragraph*.307}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.4}{\ignorespaces Centroid decomposition of the running example. Removing the centroid 0 leaves parts of 6, 5 and 1 vertices, at most $13/2$ each; their centroids 4, 6 and 3 form level 1, and so on. Right: the centroid tree, of depth $3 \le \log _2 13$. The path from 11 to 9 contains exactly one vertex of the lowest level, 0, which is the LCA of 11 and 9 in the centroid tree.}}{234}{figure.caption.308}\protected@file@percent }
\newlabel{fig:centroid}{{17.4}{234}{Centroid decomposition of the running example. Removing the centroid 0 leaves parts of 6, 5 and 1 vertices, at most $13/2$ each; their centroids 4, 6 and 3 form level 1, and so on. Right: the centroid tree, of depth $3 \le \log _2 13$. The path from 11 to 9 contains exactly one vertex of the lowest level, 0, which is the LCA of 11 and 9 in the centroid tree}{figure.caption.308}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.5}{\ignorespaces Counting the paths of length $k = 3$ through a centroid $c$; vertices show their depth below $c$. Branch B finds $\mathit  {cnt}[2] + \mathit  {cnt}[1] = 3$ partners for its depths 1 and 2, branch C finds 6, so $0 + 3 + 6 = 9$ paths pass through $c$. Paths inside one branch are counted later, at a deeper centroid.}}{235}{figure.caption.309}\protected@file@percent }
\newlabel{fig:fixedlen}{{17.5}{235}{Counting the paths of length $k = 3$ through a centroid $c$; vertices show their depth below $c$. Branch B finds $\mathit {cnt}[2] + \mathit {cnt}[1] = 3$ partners for its depths 1 and 2, branch C finds 6, so $0 + 3 + 6 = 9$ paths pass through $c$. Paths inside one branch are counted later, at a deeper centroid}{figure.caption.309}{}}
\@writefile{toc}{\contentsline {paragraph}{Fixed-Length Paths II: a range of lengths.}{236}{paragraph*.310}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {17.2.1}The centroid tree as a data structure}{236}{subsection.17.2.1}\protected@file@percent }
\newlabel{tpl:cpcentroid}{{17.2.1}{238}{The centroid tree as a data structure}{section*.311}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.3}DSU on tree}{238}{section.17.3}\protected@file@percent }
\newlabel{sec:sack}{{17.3}{238}{DSU on tree}{section.17.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.6}{\ignorespaces DSU on tree. Left: when $v$ is processed, the heavy child's counts are still in the array, and only $v$ and the light subtrees are added. Right: why every vertex is added $\ensuremath  {\mathcal  {O}(\log n)}$ times.}}{239}{figure.caption.312}\protected@file@percent }
\newlabel{fig:sack}{{17.6}{239}{DSU on tree. Left: when $v$ is processed, the heavy child's counts are still in the array, and only $v$ and the light subtrees are added. Right: why every vertex is added $\Oh {\log n}$ times}{figure.caption.312}{}}
\newlabel{tpl:cpsack}{{17.3}{240}{DSU on tree}{section*.313}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.4}Long-path decomposition}{241}{section.17.4}\protected@file@percent }
\newlabel{sec:longpath}{{17.4}{241}{Long-path decomposition}{section.17.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Long paths.}{241}{paragraph*.314}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.7}{\ignorespaces Long-path decomposition. Each long path owns one block of the buffer, so a vertex inherits its long child's counts in $\ensuremath  {\mathcal  {O}(1)}$; only the short child 3 is merged by hand. Three vertices lie at distance 2 below 1, the most at any distance, so the dominant depth of 1 is 2.}}{241}{figure.caption.315}\protected@file@percent }
\newlabel{fig:longpath}{{17.7}{241}{Long-path decomposition. Each long path owns one block of the buffer, so a vertex inherits its long child's counts in $\Oh {1}$; only the short child 3 is merged by hand. Three vertices lie at distance 2 below 1, the most at any distance, so the dominant depth of 1 is 2}{figure.caption.315}{}}
\newlabel{tpl:cplongpath}{{17.4}{242}{Long paths}{section*.316}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.5}Virtual trees}{243}{section.17.5}\protected@file@percent }
\newlabel{sec:virtualtree}{{17.5}{243}{Virtual trees}{section.17.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.8}{\ignorespaces The virtual tree of the keys 11, 8, 5 and 12 (red). In DFS order the keys are 11, 8, 5, 12, and the LCAs of neighbours in that order, 4, 1 and 0 (blue), complete the vertex set. The smallest subtree containing the keys (green) has 10 edges, the total weight of the virtual tree.}}{243}{figure.caption.317}\protected@file@percent }
\newlabel{fig:virtualtree}{{17.8}{243}{The virtual tree of the keys 11, 8, 5 and 12 (red). In DFS order the keys are 11, 8, 5, 12, and the LCAs of neighbours in that order, 4, 1 and 0 (blue), complete the vertex set. The smallest subtree containing the keys (green) has 10 edges, the total weight of the virtual tree}{figure.caption.317}{}}
\@writefile{toc}{\contentsline {paragraph}{Construction.}{243}{paragraph*.318}\protected@file@percent }
\newlabel{tpl:cpvirtual}{{17.5}{244}{Construction}{section*.319}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.6}Euler tour trees}{245}{section.17.6}\protected@file@percent }
\newlabel{sec:ett}{{17.6}{245}{Euler tour trees}{section.17.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Representation.}{245}{paragraph*.320}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.9}{\ignorespaces An Euler tour tree. The tour lists every vertex once (white) and every edge once in each direction (grey). Rerooting at b rotates the tour; cutting b--d removes the two edge nodes (red) together with d's side between them (blue), which leaves the tour of the remaining tree and the tour of d alone.}}{246}{figure.caption.321}\protected@file@percent }
\newlabel{fig:ett}{{17.9}{246}{An Euler tour tree. The tour lists every vertex once (white) and every edge once in each direction (grey). Rerooting at b rotates the tour; cutting b--d removes the two edge nodes (red) together with d's side between them (blue), which leaves the tour of the remaining tree and the tour of d alone}{figure.caption.321}{}}
\newlabel{tpl:cpett}{{17.6}{246}{Representation}{section*.322}{}}
