\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Type ranges (bars) against quantities that appear in contests (red ticks), on a logarithmic ruler. A sum of $2\cdot 10^5$ values up to $10^9$ overflows \texttt  {int} by a factor of $10^5$; a product of two such values fits in \texttt  {long long} with a factor of 9 to spare, but a product of three does not fit anywhere except \texttt  {\_\_int128}.}}{41}{figure.caption.63}\protected@file@percent }
\newlabel{fig:ranges}{{4.1}{41}{Type ranges (bars) against quantities that appear in contests (red ticks), on a logarithmic ruler. A sum of $2\cdot 10^5$ values up to $10^9$ overflows \texttt {int} by a factor of $10^5$; a product of two such values fits in \texttt {long long} with a factor of 9 to spare, but a product of three does not fit anywhere except \texttt {\_\_int128}}{figure.caption.63}{}}
