\@writefile{toc}{\contentsline {section}{\numberline {11.9}Bidirectional search and A*}{147}{section.11.9}\protected@file@percent }
\newlabel{sec:bibfs}{{11.9}{147}{Bidirectional search and A*}{section.11.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Bidirectional BFS.}{147}{paragraph*.195}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11.10}{\ignorespaces Why bidirectional search wins: in a graph where the number of states within distance $r$ grows like $b^r$, two balls of radius $d/2$ contain far fewer states than one ball of radius $d$.}}{147}{figure.caption.196}\protected@file@percent }
\newlabel{fig:bibfs}{{11.10}{147}{Why bidirectional search wins: in a graph where the number of states within distance $r$ grows like $b^r$, two balls of radius $d/2$ contain far fewer states than one ball of radius $d$}{figure.caption.196}{}}
\newlabel{tpl:cpbibfs}{{11.9}{148}{Bidirectional BFS}{section*.198}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.11}{\ignorespaces Swap Game: the number of states that each search explores in the worst case, computed from the exact distance distribution of all $9!$ states. At distance 10 bidirectional search explores 16 times fewer states; near the maximum distance 16 the gain shrinks, because a plain BFS cannot explore more than the $9!$ states that exist.}}{149}{figure.caption.197}\protected@file@percent }
\newlabel{fig:swapstates}{{11.11}{149}{Swap Game: the number of states that each search explores in the worst case, computed from the exact distance distribution of all $9!$ states. At distance 10 bidirectional search explores 16 times fewer states; near the maximum distance 16 the gain shrinks, because a plain BFS cannot explore more than the $9!$ states that exist}{figure.caption.197}{}}
