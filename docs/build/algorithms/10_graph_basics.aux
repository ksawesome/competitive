\@writefile{lof}{\contentsline {figure}{\numberline {11.4}{\ignorespaces BFS explores layer by layer. The queue holds at most two consecutive layers at a time, so the first discovery of a vertex is along a shortest path.}}{137}{figure.caption.179}\protected@file@percent }
