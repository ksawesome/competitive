\newlabel{sec:dfs}{{11.3}{135}{Depth-first search}{section.11.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.3}{\ignorespaces DFS from vertex 0 on a directed graph and the classification of its edges. The back edges $2 \to 0$ and $5 \to 3$ each close a cycle. The intervals from discovery to finishing time (table) nest exactly as the tree does: $[2, 5]$ and $[6, 11]$ lie inside $[1, 12]$ and are disjoint from each other.}}{136}{figure.caption.177}\protected@file@percent }
\newlabel{fig:dfsclasses}{{11.3}{136}{DFS from vertex 0 on a directed graph and the classification of its edges. The back edges $2 \to 0$ and $5 \to 3$ each close a cycle. The intervals from discovery to finishing time (table) nest exactly as the tree does: $[2, 5]$ and $[6, 11]$ lie inside $[1, 12]$ and are disjoint from each other}{figure.caption.177}{}}
