\@writefile{lof}{\contentsline {figure}{\numberline {11.12}{\ignorespaces BFS versus A* from the green start to the red target around a wall (dark). Blue cells were expanded before the target; both searches find a shortest path of length 20 (red), but A* with the Manhattan distance as its bound expands half as many cells.}}{149}{figure.caption.200}\protected@file@percent }
\newlabel{fig:astar}{{11.12}{149}{BFS versus A* from the green start to the red target around a wall (dark). Blue cells were expanded before the target; both searches find a shortest path of length 20 (red), but A* with the Manhattan distance as its bound expands half as many cells}{figure.caption.200}{}}
