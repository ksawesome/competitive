\@writefile{lof}{\contentsline {figure}{\numberline {11.8}{\ignorespaces Three colours in a directed DFS. The search is at vertex 4 with the path $1 \to 2 \to 3 \to 4$ open. The edge $3 \to 5$ led to a finished vertex (no cycle there), but the edge $4 \to 2$ enters an open vertex and closes a cycle.}}{145}{figure.caption.189}\protected@file@percent }
\newlabel{fig:dircycle}{{11.8}{145}{Three colours in a directed DFS. The search is at vertex 4 with the path $1 \to 2 \to 3 \to 4$ open. The edge $3 \to 5$ led to a finished vertex (no cycle there), but the edge $4 \to 2$ enters an open vertex and closes a cycle}{figure.caption.189}{}}
