\@writefile{lof}{\contentsline {figure}{\numberline {11.7}{\ignorespaces Two-colouring by BFS parity. In (a) the colouring succeeds. In (b), a 5-cycle, some edge must join equal colours: graphs with an odd cycle are exactly the graphs that are not bipartite.}}{142}{figure.caption.185}\protected@file@percent }
\newlabel{fig:bipartite}{{11.7}{142}{Two-colouring by BFS parity. In (a) the colouring succeeds. In (b), a 5-cycle, some edge must join equal colours: graphs with an odd cycle are exactly the graphs that are not bipartite}{figure.caption.185}{}}
