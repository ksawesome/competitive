\newlabel{fig:countingsort}{{7.3}{82}{Counting sort with keys in $[0, 4)$. Count the keys, turn the counts into first positions with a prefix sum, then place the items in input order, each at the next free position of its key}{figure.caption.110}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Radix sort of three-digit numbers: three stable counting sorts, by the ones digit, the tens digit and the hundreds digit (the digit used in each pass is red). After the pass on the tens digit, the numbers are sorted by their last two digits; after the last pass, completely.}}{82}{figure.caption.112}\protected@file@percent }
\newlabel{fig:radix}{{7.4}{82}{Radix sort of three-digit numbers: three stable counting sorts, by the ones digit, the tens digit and the hundreds digit (the digit used in each pass is red). After the pass on the tens digit, the numbers are sorted by their last two digits; after the last pass, completely}{figure.caption.112}{}}
