\@writefile{toc}{\contentsline {subsection}{\numberline {7.6.1}Medians minimise distances}{87}{subsection.7.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces The cost $f(x) = \DOTSI \sumop \slimits@ |p_i - x|$ for sticks $1, 2, 3, 7, 9$. It is piecewise linear and convex; its slope (numbers on the segments) goes up by 2 at each stick, and changes sign at the median.}}{87}{figure.caption.120}\protected@file@percent }
\newlabel{fig:sticks}{{7.9}{87}{The cost $f(x) = \sum |p_i - x|$ for sticks $1, 2, 3, 7, 9$. It is piecewise linear and convex; its slope (numbers on the segments) goes up by 2 at each stick, and changes sign at the median}{figure.caption.120}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.6.2}Merging with the smallest first: Huffman's algorithm}{87}{subsection.7.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.10}{\ignorespaces Cutting a stick of length 18 into pieces $2, 3, 5, 8$ (orange). Huffman's algorithm joins $2 + 3 = 5$, then $5 + 5 = 10$, then $10 + 8 = 18$; the cuts (blue) cost $5 + 10 + 18 = 33 = 8 \cdot 1 + 5 \cdot 2 + 2 \cdot 3 + 3 \cdot 3$.}}{88}{figure.caption.121}\protected@file@percent }
\newlabel{fig:huffman}{{7.10}{88}{Cutting a stick of length 18 into pieces $2, 3, 5, 8$ (orange). Huffman's algorithm joins $2 + 3 = 5$, then $5 + 5 = 10$, then $10 + 8 = 18$; the cuts (blue) cost $5 + 10 + 18 = 33 = 8 \cdot 1 + 5 \cdot 2 + 2 \cdot 3 + 3 \cdot 3$}{figure.caption.121}{}}
