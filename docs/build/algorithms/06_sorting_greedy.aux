\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Missing Coin Sum with the sorted coins $1, 1, 3, 6, 20$. Each green bar is the range $0, \ldots  , r$ of sums that can be formed after taking the coins so far. Each coin at most $r + 1$ extends the range without a gap; the coin 20 would leave the gap $12, \ldots  , 19$, so the answer is 12.}}{80}{figure.caption.106}\protected@file@percent }
\newlabel{fig:missingcoin}{{7.1}{80}{Missing Coin Sum with the sorted coins $1, 1, 3, 6, 20$. Each green bar is the range $0, \ldots , r$ of sums that can be formed after taking the coins so far. Each coin at most $r + 1$ extends the range without a gap; the coin 20 would leave the gap $12, \ldots , 19$, so the answer is 12}{figure.caption.106}{}}
