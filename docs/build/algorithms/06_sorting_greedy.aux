\@writefile{lot}{\contentsline {table}{\numberline {7.2}{\ignorespaces Classic greedy rules. The 0/1 knapsack and coin change with arbitrary coins are \emph  {not} solved by greedy rules; they need dynamic programming (Part~V).}}{89}{table.caption.122}\protected@file@percent }
\newlabel{tab:greedyrules}{{7.2}{89}{Classic greedy rules. The 0/1 knapsack and coin change with arbitrary coins are \emph {not} solved by greedy rules; they need dynamic programming (Part~V)}{table.caption.122}{}}
