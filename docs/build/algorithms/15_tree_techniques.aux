\@writefile{lof}{\contentsline {figure}{\numberline {16.3}{\ignorespaces The two-BFS diameter algorithm; the numbers are BFS distances. The farthest vertex from $s$ is $a$, the farthest from $a$ is $b$, and $a$--$b$ (red) is a diameter. Panel~3 is the corollary: the farthest vertex from any vertex is $a$ or $b$.}}{209}{figure.caption.275}\protected@file@percent }
\newlabel{fig:diameter}{{16.3}{209}{The two-BFS diameter algorithm; the numbers are BFS distances. The farthest vertex from $s$ is $a$, the farthest from $a$ is $b$, and $a$--$b$ (red) is a diameter. Panel~3 is the corollary: the farthest vertex from any vertex is $a$ or $b$}{figure.caption.275}{}}
