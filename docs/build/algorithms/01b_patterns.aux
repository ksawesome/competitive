\@writefile{toc}{\contentsline {section}{\numberline {2.8}Pigeonhole}{22}{section.2.8}\protected@file@percent }
\newlabel{sec:pigeonhole}{{2.8}{22}{Pigeonhole}{section.2.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.7}{\ignorespaces $n = 5$: six prefix sums and five possible remainders, so some box must hold two. Box 3 holds $P_1, P_3$ (the subarray $1, 4$); box 4 holds $P_2, P_4, P_5$ (the subarrays $4, 1$ and $4, 1, 5$ and $5$). In total $\binom  22 + \binom  32 = 4$ subarrays have a sum divisible by 5.}}{22}{figure.caption.37}\protected@file@percent }
\newlabel{fig:pigeonhole}{{2.7}{22}{$n = 5$: six prefix sums and five possible remainders, so some box must hold two. Box 3 holds $P_1, P_3$ (the subarray $1, 4$); box 4 holds $P_2, P_4, P_5$ (the subarrays $4, 1$ and $4, 1, 5$ and $5$). In total $\binom 22 + \binom 32 = 4$ subarrays have a sum divisible by 5}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.9}The extremal principle}{23}{section.2.9}\protected@file@percent }
\newlabel{sec:extremal}{{2.9}{23}{The extremal principle}{section.2.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces The extremal principle: the endpoints of a longest path cannot have any other neighbour.}}{23}{figure.caption.38}\protected@file@percent }
\newlabel{fig:extremal}{{2.8}{23}{The extremal principle: the endpoints of a longest path cannot have any other neighbour}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.10}Symmetry and reflection}{23}{section.2.10}\protected@file@percent }
\newlabel{sec:symmetry}{{2.10}{23}{Symmetry and reflection}{section.2.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.9}{\ignorespaces The reflection principle. Reflecting the tail of a bad path across $y = x + 1$ moves its endpoint from $(n, n)$ to $(n - 1, n + 1)$, which turns ``count the bad paths'' into a single binomial coefficient.}}{24}{figure.caption.39}\protected@file@percent }
\newlabel{fig:reflection}{{2.9}{24}{The reflection principle. Reflecting the tail of a bad path across $y = x + 1$ moves its endpoint from $(n, n)$ to $(n - 1, n + 1)$, which turns ``count the bad paths'' into a single binomial coefficient}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.11}When the answer is small}{24}{section.2.11}\protected@file@percent }
\newlabel{sec:small-answer}{{2.11}{24}{When the answer is small}{section.2.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.10}{\ignorespaces Subarray gcds of $12, 18, 6, 9, 3$, one row per right end. Colours mark equal values; every row is a short chain of divisors, which is what makes the $\ensuremath  {\mathcal  {O}(n \log A)}$ algorithm possible.}}{25}{figure.caption.40}\protected@file@percent }
\newlabel{fig:gcdchain}{{2.10}{25}{Subarray gcds of $12, 18, 6, 9, 3$, one row per right end. Colours mark equal values; every row is a short chain of divisors, which is what makes the $\Oh {n \log A}$ algorithm possible}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.12}Heavy and light}{25}{section.2.12}\protected@file@percent }
\newlabel{sec:heavylight}{{2.12}{25}{Heavy and light}{section.2.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.11}{\ignorespaces The square-root split. Few objects can be large (their sizes add up to at most $S$), so they can afford expensive precomputation; the many small ones are cheap to handle directly.}}{26}{figure.caption.41}\protected@file@percent }
\newlabel{fig:heavylight}{{2.11}{26}{The square-root split. Few objects can be large (their sizes add up to at most $S$), so they can afford expensive precomputation; the many small ones are cheap to handle directly}{figure.caption.41}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.13}Differences instead of values}{26}{section.2.13}\protected@file@percent }
