\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces The contribution of one element. It rules the shaded window, which stops just before the nearest smaller elements on each side (green). Summing $a_i \cdot (\text  {choices of start}) \cdot (\text  {choices of end})$ over all $i$ counts every subarray exactly once.}}{15}{figure.caption.31}\protected@file@percent }
\newlabel{fig:contribution}{{2.1}{15}{The contribution of one element. It rules the shaded window, which stops just before the nearest smaller elements on each side (green). Summing $a_i \cdot (\text {choices of start}) \cdot (\text {choices of end})$ over all $i$ counts every subarray exactly once}{figure.caption.31}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.2}Fix one thing}{16}{section.2.2}\protected@file@percent }
\newlabel{sec:fixone}{{2.2}{16}{Fix one thing}{section.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Fixing the middle element makes the two sides independent: $j$ contributes (smaller on the left) $\times $ (larger on the right).}}{16}{figure.caption.32}\protected@file@percent }
\newlabel{fig:fixmiddle}{{2.2}{16}{Fixing the middle element makes the two sides independent: $j$ contributes (smaller on the left) $\times $ (larger on the right)}{figure.caption.32}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.3}Complementary counting}{17}{section.2.3}\protected@file@percent }
\newlabel{sec:complement}{{2.3}{17}{Complementary counting}{section.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Counting the complement: subarrays that avoid the large elements (orange) live inside the maximal runs of small elements (blue), and a run of length $\ell $ holds $\ell (\ell +1)/2$ of them.}}{17}{figure.caption.33}\protected@file@percent }
\newlabel{fig:complement}{{2.3}{17}{Counting the complement: subarrays that avoid the large elements (orange) live inside the maximal runs of small elements (blue), and a run of length $\ell $ holds $\ell (\ell +1)/2$ of them}{figure.caption.33}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.4}Reverse time and go offline}{18}{section.2.4}\protected@file@percent }
\newlabel{sec:reverse}{{2.4}{18}{Reverse time and go offline}{section.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Forwards, the network loses edges; backwards, it gains them. Starting from the last state and adding the edges back in reverse order visits the same states, so the component counts can be read off the DSU. Output: \texttt  {1 1 2}.}}{18}{figure.caption.34}\protected@file@percent }
\newlabel{fig:reverse}{{2.4}{18}{Forwards, the network loses edges; backwards, it gains them. Starting from the last state and adding the edges back in reverse order visits the same states, so the component counts can be read off the DSU. Output: \texttt {1 1 2}}{figure.caption.34}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.5}Events and sweeps}{19}{section.2.5}\protected@file@percent }
\newlabel{sec:events}{{2.5}{19}{Events and sweeps}{section.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Four customers (bars) and the number present over time (the step function below). Each arrival lifts the step by one and each departure lowers it; the maximum, 3, is reached between times 4 and 5.}}{20}{figure.caption.35}\protected@file@percent }
\newlabel{fig:sweep}{{2.5}{20}{Four customers (bars) and the number present over time (the step function below). Each arrival lifts the step by one and each departure lowers it; the maximum, 3, is reached between times 4 and 5}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.6}Invariants and colourings}{20}{section.2.6}\protected@file@percent }
\newlabel{sec:invariants}{{2.6}{20}{Invariants and colourings}{section.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces A colouring invariant. The count ``dark squares covered minus light squares covered'' is zero for any set of dominoes, but it would have to be $-2$ here.}}{21}{figure.caption.36}\protected@file@percent }
\newlabel{fig:chessboard}{{2.6}{21}{A colouring invariant. The count ``dark squares covered minus light squares covered'' is zero for any set of dominoes, but it would have to be $-2$ here}{figure.caption.36}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.7}Monovariants and termination}{21}{section.2.7}\protected@file@percent }
