\@writefile{lof}{\contentsline {figure}{\numberline {2.12}{\ignorespaces Target $2, 4, 1, 3, 3, 0$ cut into horizontal layers. The number of runs equals the sum of the positive differences $b_i - b_{i-1}$, and no sequence of range increments can do better.}}{27}{figure.caption.42}\protected@file@percent }
\newlabel{fig:differences}{{2.12}{27}{Target $2, 4, 1, 3, 3, 0$ cut into horizontal layers. The number of runs equals the sum of the positive differences $b_i - b_{i-1}$, and no sequence of range increments can do better}{figure.caption.42}{}}
