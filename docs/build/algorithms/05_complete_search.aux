\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces A robot run on a $4 \times 5$ grid with three walls (grey), starting at the dot facing up. It goes up, turns right twice at the edge, comes back down (orange tail) and then circles rows 2 and 3 forever (blue cycle). Right: the same run as a sequence of states. The state at time 5 recurs at time 19, so for every $T \ge 5$ the state at time $T$ is the state at time $5 + (T - 5) \bmod  14$.}}{63}{figure.caption.88}\protected@file@percent }
\newlabel{fig:robot}{{6.1}{63}{A robot run on a $4 \times 5$ grid with three walls (grey), starting at the dot facing up. It goes up, turns right twice at the edge, comes back down (orange tail) and then circles rows 2 and 3 forever (blue cycle). Right: the same run as a sequence of states. The state at time 5 recurs at time 19, so for every $T \ge 5$ the state at time $T$ is the state at time $5 + (T - 5) \bmod 14$}{figure.caption.88}{}}
