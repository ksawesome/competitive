\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces Meet in the middle for subset sums. $L$ and $R$ hold the $2^{n/2}$ subset sums of each half, sorted. A subset of all items is one sum from each list, so the pairs adding up to $x$ are exactly the subsets with sum $x$.}}{74}{figure.caption.101}\protected@file@percent }
\newlabel{fig:mitm}{{6.7}{74}{Meet in the middle for subset sums. $L$ and $R$ hold the $2^{n/2}$ subset sums of each half, sorted. A subset of all items is one sum from each list, so the pairs adding up to $x$ are exactly the subsets with sum $x$}{figure.caption.101}{}}
