\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces Left: the whole backtracking tree for four queens; a node is the column of the queen placed in the next row. Red nodes are dead ends (the following row has no safe square), green nodes complete a solution. Right: the solution $2, 4, 1, 3$; the other one is its mirror image $3, 1, 4, 2$.}}{70}{figure.caption.97}\protected@file@percent }
\newlabel{fig:queens}{{6.5}{70}{Left: the whole backtracking tree for four queens; a node is the column of the queen placed in the next row. Red nodes are dead ends (the following row has no safe square), green nodes complete a solution. Right: the solution $2, 4, 1, 3$; the other one is its mirror image $3, 1, 4, 2$}{figure.caption.97}{}}
\newlabel{tpl:cpbacktrack}{{6.5}{71}{Backtracking and pruning}{section*.98}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5.1}A case study in pruning: Grid Paths}{71}{subsection.6.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces Dead partial paths in Grid Paths. The path (red) starts at the dot; the green circle marks the end corner and the red square the current position. Blue squares are free; orange squares are free but can no longer be reached once the path chooses a side. In (b) and (c) the current square is blocked on two opposite sides and free on the other two, which is exactly the test in the code.}}{72}{figure.caption.99}\protected@file@percent }
\newlabel{fig:gridpaths}{{6.6}{72}{Dead partial paths in Grid Paths. The path (red) starts at the dot; the green circle marks the end corner and the red square the current position. Blue squares are free; orange squares are free but can no longer be reached once the path chooses a side. In (b) and (c) the current square is blocked on two opposite sides and free on the other two, which is exactly the test in the code}{figure.caption.99}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.2}{\ignorespaces Counting all 88\,418 paths (a description of 48 question marks) with more and more pruning, measured with \texttt  {g++ -O2}. The split rule alone makes the search 230 times faster.}}{72}{table.caption.100}\protected@file@percent }
\newlabel{tab:gridpruning}{{6.2}{72}{Counting all 88\,418 paths (a description of 48 question marks) with more and more pruning, measured with \texttt {g++ -O2}. The split rule alone makes the search 230 times faster}{table.caption.100}{}}
