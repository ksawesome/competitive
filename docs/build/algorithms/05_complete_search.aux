\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces The 8 subsets of $\{a, b, c\}$ (bit 0 is $a$, bit 1 is $b$, bit 2 is $c$; blue bits are chosen items). Left: in counting order, one step can change many bits ($3 \to 4$ changes all three). Right: in Gray code order $g_k = k \oplus \lfloor k/2 \rfloor $, every step flips exactly one bit (red), and step $k$ flips bit number $\operatorname  {ctz}(k)$.}}{66}{figure.caption.92}\protected@file@percent }
\newlabel{fig:bitmasks}{{6.3}{66}{The 8 subsets of $\{a, b, c\}$ (bit 0 is $a$, bit 1 is $b$, bit 2 is $c$; blue bits are chosen items). Left: in counting order, one step can change many bits ($3 \to 4$ changes all three). Right: in Gray code order $g_k = k \oplus \lfloor k/2 \rfloor $, every step flips exactly one bit (red), and step $k$ flips bit number $\operatorname {ctz}(k)$}{figure.caption.92}{}}
