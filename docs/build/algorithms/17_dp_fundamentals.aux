\@writefile{toc}{\contentsline {paragraph}{The $\ensuremath  {\mathcal  {O}(n \log n)}$ method.}{258}{paragraph*.334}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.8}{\ignorespaces The tails for $3, 1, 4, 1, 5, 9, 2, 6$. The final list has length 4, the LIS length. The tails themselves ($1, 2, 5, 6$) are not a subsequence; following each element's predecessor, the tail before it at the moment it was placed, gives one: $1, 4, 5, 6$.}}{258}{figure.caption.335}\protected@file@percent }
\newlabel{fig:lis}{{18.8}{258}{The tails for $3, 1, 4, 1, 5, 9, 2, 6$. The final list has length 4, the LIS length. The tails themselves ($1, 2, 5, 6$) are not a subsequence; following each element's predecessor, the tail before it at the moment it was placed, gives one: $1, 4, 5, 6$}{figure.caption.335}{}}
