\newlabel{ch:dp}{{18}{250}{Dynamic Programming Fundamentals}{chapter.18}{}}
\@writefile{toc}{\contentsline {section}{\numberline {18.1}What DP is}{250}{section.18.1}\protected@file@percent }
\newlabel{sec:dp-what}{{18.1}{250}{What DP is}{section.18.1}{}}
\@writefile{toc}{\contentsline {paragraph}{DP is a computation on a DAG.}{250}{paragraph*.325}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.1}{\ignorespaces Left: the recursion tree of $F_5$ has 15 calls, because $F_3$ (orange) is solved twice and $F_2$ (blue) three times. Right: the same computation as a DAG of distinct states, where an arrow points to a value that is needed; DP evaluates each state once, in an order that respects the arrows.}}{251}{figure.caption.324}\protected@file@percent }
\newlabel{fig:fibdag}{{18.1}{251}{Left: the recursion tree of $F_5$ has 15 calls, because $F_3$ (orange) is solved twice and $F_2$ (blue) three times. Right: the same computation as a DAG of distinct states, where an arrow points to a value that is needed; DP evaluates each state once, in an order that respects the arrows}{figure.caption.324}{}}
\@writefile{toc}{\contentsline {section}{\numberline {18.2}The recipe}{251}{section.18.2}\protected@file@percent }
\newlabel{sec:dp-recipe}{{18.2}{251}{The recipe}{section.18.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18.2}{\ignorespaces The recipe on Dice Combinations. Each state adds up the six states before it; $dp[0] = 1$ counts the empty sequence.}}{252}{figure.caption.326}\protected@file@percent }
\newlabel{fig:dice}{{18.2}{252}{The recipe on Dice Combinations. Each state adds up the six states before it; $dp[0] = 1$ counts the empty sequence}{figure.caption.326}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {18.2.1}Top-down or bottom-up}{252}{subsection.18.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {18.2.2}Pulling and pushing}{252}{subsection.18.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.3}{\ignorespaces The same transitions in pull form (left) and push form (right). Pull computes one state from finished ones; push distributes one finished state forwards.}}{253}{figure.caption.327}\protected@file@percent }
\newlabel{fig:pullpush}{{18.3}{253}{The same transitions in pull form (left) and push form (right). Pull computes one state from finished ones; push distributes one finished state forwards}{figure.caption.327}{}}
\@writefile{toc}{\contentsline {section}{\numberline {18.3}Coins and sums}{253}{section.18.3}\protected@file@percent }
\newlabel{sec:dp-coins}{{18.3}{253}{Coins and sums}{section.18.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18.4}{\ignorespaces Minimizing Coins for every sum up to 11. The last coin is 1, 5 or 7, so $dp[11]$ looks back at three cells.}}{253}{figure.caption.328}\protected@file@percent }
\newlabel{fig:mincoins}{{18.4}{253}{Minimizing Coins for every sum up to 11. The last coin is 1, 5 or 7, so $dp[11]$ looks back at three cells}{figure.caption.328}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {18.3.1}Counting: the order of the loops is the order of the coins}{254}{subsection.18.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.5}{\ignorespaces Coins $\{1, 2\}$ and sum 3. With the sums in the outer loop, the inner loop chooses the last coin, so every order is counted. With the coins in the outer loop, coin 2 is added only after all coins 1 are placed, so every multiset is counted once.}}{254}{figure.caption.329}\protected@file@percent }
\newlabel{fig:coinorder}{{18.5}{254}{Coins $\{1, 2\}$ and sum 3. With the sums in the outer loop, the inner loop chooses the last coin, so every order is counted. With the coins in the outer loop, coin 2 is added only after all coins 1 are placed, so every multiset is counted once}{figure.caption.329}{}}
