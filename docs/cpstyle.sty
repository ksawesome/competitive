\definecolor{cpblue}{HTML}{1E3A8A}
\definecolor{cpteal}{HTML}{0F766E}
\definecolor{cporange}{HTML}{C2410C}
\definecolor{cpred}{HTML}{B91C1C}
\definecolor{cpgreen}{HTML}{15803D}
