% Shared style for docs/guide.tex and docs/algorithms.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cpstyle}[2026/09/29 competitive programming handbook style]

% ---------------------------------------------------------------- fonts & page
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{amsmath, mathtools}
\RequirePackage{newpxtext,newpxmath}  % provides the AMS symbols too
\renewcommand{\sfdefault}{qhv}  % TeX Gyre Heros for headings
\RequirePackage[scale=0.86]{sourcecodepro}
\RequirePackage[a4paper, top=2.4cm, bottom=2.4cm, left=2.3cm, right=2.3cm, headheight=16pt]{geometry}
\RequirePackage{microtype}
\RequirePackage{emptypage}
\linespread{1.06}
\raggedbottom  % never stretch vertical space to fill a page
\setlength{\emergencystretch}{3em}  % long file names and flags in \texttt cannot hyphenate; let the spaces stretch instead
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}

% ---------------------------------------------------------------- packages
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable, listings, raster}
% \cpneedspace{len}: start a new page unless at least len is left on this one. needspace's \penalty-100 is a break that
% \raggedbottom always finds attractive, which leaves pages half empty; a zero penalty is as good as the break before any
% paragraph, and it still makes TeX finish an overfull page before the check (none right after a heading)
\newcommand{\cpneedspace}[1]{\par\if@nobreak\penalty\@M\else\penalty\z@\fi
  \begingroup\dimen@=#1\relax\dimen@ii=\pagegoal\advance\dimen@ii-\pagetotal
  \ifdim\pagegoal<\maxdimen\ifdim\dimen@ii<\dimen@\newpage\fi\fi\endgroup}
% "before skip" that also moves the box to the next page when less than #2 is left on this one, so a breakable box is
% never split right after its first line or two
\tcbset{keep before/.style 2 args={before={%
  \ifnum\lastnodetype=-1\relax\else
    \cpneedspace{#2}%
    \ifvmode\addvspace{\glueexpr#1-\parskip}\nointerlineskip\fi
  \fi
  \lineskip\z@skip\noindent}}}
\RequirePackage{cpfig}  % TikZ, pgfplots, forest and the figure grammar (palette, styles, figure macros)
\pgfplotsset{compat=1.18}
\usetikzlibrary{shadows}
\RequirePackage{booktabs, tabularx, longtable, array, multirow, makecell, colortbl}
\RequirePackage{multicol}
\RequirePackage{algpseudocodex}
\ifdefined\cpwithindex
  \RequirePackage[noautomatic]{imakeidx}
  \makeindex[intoc, columns=2, title=Index, options={-s cpindex.ist}]
\fi
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[font={small,sf}, labelfont={bf,color=cpblue}]{caption}
\RequirePackage{float}
\RequirePackage{wrapfig}
\RequirePackage{fontawesome5}

% floats: let figures sit at the top or bottom of pages instead of leaving gaps; never split a paragraph's
% first or last line from the rest
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.6}
\renewcommand{\textfraction}{0.12}
\renewcommand{\floatpagefraction}{0.75}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\widowpenalty=10000
\clubpenalty=10000

