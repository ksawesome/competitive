\NewDocumentCommand{\defn}{om}{\textbf{\color{cpblue}#2}%
  \ifdefined\cpwithindex\IfNoValueTF{#1}{\index{#2}}{\index{#1}}\fi}
\newcommand{\tagline}[1]{{\sffamily\small\color{cpgray}#1}}

