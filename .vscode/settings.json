{
    // IntelliSense uses the same compiler and macros as CPH, so bits/stdc++.h and dbg() resolve.
    "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.defines": ["LOCAL"],
    "C_Cpp.default.includePath": ["${workspaceFolder}/include"],

    // Hide build output and CPH metadata from the explorer.
    "files.exclude": {
        "**/*.exe": true,
        "**/*.bin": true,
        "**/*.gch": true,
        "**/.cph": true,
        ".build": true,
        "docs/build": true
    },
    "files.watcherExclude": {
        "**/.build/**": true,
        "**/include/bits/**": true
    },
    "search.exclude": {
        ".build": true,
        "include/bits": true
    },

    // Type a template prefix (cpdfs, cpseg, ...) and press Tab.
    "editor.tabCompletion": "onlySnippets",

    // Code Runner (Ctrl+Alt+N) uses the same compile flags and runner as F5.
    "code-runner.executorMap": {
        "cpp": "python \"C:/Users/kshit/Desktop/competitive/tools/cp.py\" run \"$fullFileName\""
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true
}
